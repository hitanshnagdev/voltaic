# Voltaic environment
#
# Copy to .env.local and fill. .env.local is gitignored.
# Production secrets live in Vercel project env vars.

# ==== Required to start (Phases 0–2) ====

# Clerk (dev instance: https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/today
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/today

# Anthropic (Haiku 4.5 classify, Sonnet 4.6 reason, Opus 4.7 hardest pages)
ANTHROPIC_API_KEY=

# Voyage AI (voyage-3 embeddings + voyage-rerank-2)
VOYAGE_API_KEY=

# Neon Postgres. Must have pgvector, pg_trgm, pgcrypto extensions.
# Run `npm run db:init` on a fresh branch to enable them.
DATABASE_URL=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Inngest — in local dev, the Inngest dev server handles keys automatically.
# Set these only for prod (Vercel) deploys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ==== Required by Phase 3 (submittal + panel-schedule OCR) ====

# AWS Textract. IAM user scoped to textract:* and s3:GetObject on the R2
# staging bucket (or we can stream bytes from R2 and skip S3 entirely).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ==== Required by Phase 9 (hot-finding consensus) ====

# Google Gemini 2.5 Pro — only invoked when severity=hot AND confidence<0.85.
GOOGLE_API_KEY=

# ==== Optional ops knobs ====

# Maximum upload size in BYTES. Default is 50 MB (52428800).
# Real construction bid sets routinely exceed 100 MB; raise this in prod
# if customers report hitting the cap.
# UPLOAD_MAX_BYTES=104857600
